---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import { url } from '../config/site';

interface Props {
  /** Full page title — each page passes its own */
  title: string;
  description: string;
  /** Social preview image: path under /public or absolute URL */
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B2545" />
    <SEO title={title} description={description} image={image} imageAlt={imageAlt} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-60 rounded-md bg-white px-4 py-3 font-bold text-navy focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >Skip to main content</a
    >
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <RevealOnScroll />
  </body>
</html>
