---
/**
 * Hybrid battery landing page — the lowest-competition, highest-intent search
 * term the business can realistically win locally.
 *
 * NOTE: the symptom list and the "what we do" steps stay within what CLAUDE.md
 * records (health checks, diagnostics, repair, hybrid system servicing, genuine
 * parts and warranty). Confirm the model list and the repair-vs-replace wording
 * with Mumthaz before treating this as final.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.jsx';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { Activity, BatteryCharging, Gauge, ShieldCheck, TriangleAlert, Wrench } from 'lucide-react';
import { url } from '../config/site';

const symptoms = [
  {
    title: 'Worse fuel economy',
    text: 'The petrol engine runs more often to cover for the battery, so your mpg drops without the way you drive having changed.',
  },
  {
    title: 'The engine rarely switches off',
    text: 'Less time in electric-only mode, and the engine kicking in almost as soon as you pull away.',
  },
  {
    title: 'The charge gauge swings wildly',
    text: 'State of charge jumping from full to low and back again, rather than sitting in the middle.',
  },
  {
    title: 'Warning lights',
    text: 'The hybrid system warning light, the check engine light, or a red triangle on the dash.',
  },
  {
    title: 'Less pull when accelerating',
    text: 'The car feels flat joining a dual carriageway, because the electric motor is contributing less.',
  },
  {
    title: 'The cooling fan runs loudly',
    text: 'The battery cooling fan working hard, often because its filter is clogged with dust.',
  },
];

const steps = [
  {
    icon: Activity,
    title: 'Health check and diagnostics',
    text: 'We read the hybrid system data and check the battery at module level, so we can see which part of the pack is actually weak rather than guessing from the warning light.',
  },
  {
    icon: Wrench,
    title: 'Repair where we can',
    text: 'A failing pack often comes down to a small number of weak modules, or a cooling fault that starved the pack of air. Fixing that costs far less than replacing everything.',
  },
  {
    icon: BatteryCharging,
    title: 'Replace when we should',
    text: 'When a pack is genuinely at the end of its life, we will say so and quote for replacement — with genuine parts and a warranty.',
  },
  {
    icon: Gauge,
    title: 'Hybrid system servicing',
    text: 'Inverter coolant, cooling fan and filter, and the rest of the hybrid system — the maintenance that helps the next pack last longer.',
  },
];

const models = [
  'Toyota Prius, Prius+ and Prius Plug-in',
  'Toyota Auris, Yaris, C-HR, Corolla and RAV4 hybrids',
  'Lexus CT 200h, IS 300h, NX and RX',
  'Honda Insight, Jazz and Civic IMA',
];

const faqs = [
  {
    question: 'How long do hybrid batteries last?',
    answer:
      "There's no fixed lifespan — well-maintained packs commonly outlast the rest of the car, but performance fades gradually as cells age. That's why symptoms like reduced fuel economy or the engine running more often usually show up long before a total failure.",
  },
  {
    question: 'Can a hybrid battery be repaired instead of replaced?',
    answer:
      "Often, yes. A failing pack usually comes down to a small number of weak modules or a cooling fault, and fixing that costs far less than replacing the whole pack. We'll diagnose it properly rather than assuming it needs a full replacement.",
  },
  {
    question: 'Do you work on my hybrid model?',
    answer:
      "Toyota and Lexus hybrids are our speciality, and we cover Honda hybrids too. If your model isn't listed above, ask — the answer is usually yes.",
  },
  {
    question: 'How much does a hybrid battery repair or replacement cost?',
    answer:
      'It depends on the vehicle and whether the pack needs repairing or replacing. Message us your registration and what the car is doing on WhatsApp and we will give you a quote.',
  },
];
---

<BaseLayout
  title="Hybrid Battery Repair & Replacement in Milton Keynes | Toyotech"
  description="Hybrid battery health checks, diagnostics, repair and replacement in Bletchley, Milton Keynes. Toyota Prius, Auris, Yaris, Lexus and Honda hybrid specialists. Genuine parts and warranty."
>
  <BreadcrumbSchema slot="head" items={[{ name: 'Hybrid Battery', path: '/hybrid-battery' }]} />
  <FAQSchema slot="head" items={faqs} />

  <section class="bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <p class="font-bold tracking-wide text-brand-green uppercase">Our speciality</p>
      <h1 class="mt-2 text-4xl font-black">Hybrid battery repair in Milton Keynes</h1>
      <p class="mt-3 max-w-2xl text-lg text-white/80">
        A hybrid battery warning does not always mean a new battery. We diagnose the pack properly at our
        Bletchley workshop, and repair it where repairing is the right answer.
      </p>
      <div class="mt-6"><WhatsAppButton variant="large" /></div>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="symptoms-heading">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 id="symptoms-heading" class="text-3xl font-black text-navy">Signs your hybrid battery is struggling</h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Hybrid packs rarely fail overnight. They fade, and the car compensates — which is why the fuel economy
        usually goes before the warning light does.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          symptoms.map((symptom) => (
            <div data-reveal class="min-w-0">
              <article class="flex h-full flex-col rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200">
                <div class="mb-2 flex items-center gap-3">
                  <TriangleAlert className="h-5 w-5 shrink-0 text-brand-red" aria-hidden="true" />
                  <h3 class="text-lg font-bold text-navy">{symptom.title}</h3>
                </div>
                <p class="text-slate-600">{symptom.text}</p>
              </article>
            </div>
          ))
        }
      </div>
      <p class="mt-8 max-w-2xl text-slate-600">
        Noticing any of these? Send us a message describing what the car is doing and we will tell you whether
        it is worth bringing in.
      </p>
    </div>
  </section>

  <section class="bg-slate-50" aria-labelledby="approach-heading">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 id="approach-heading" class="text-3xl font-black text-navy">How we approach a hybrid battery</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          steps.map(({ icon: Icon, title, text }) => (
            <div data-reveal class="min-w-0">
              <article class="flex h-full flex-col rounded-2xl bg-white p-6 shadow-md ring-1 ring-slate-200">
                <div class="mb-3 flex items-center gap-3">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-green/15 text-navy">
                    <Icon className="h-6 w-6" />
                  </span>
                  <h3 class="text-xl font-bold text-navy">{title}</h3>
                </div>
                <p class="text-slate-600">{text}</p>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-navy-light text-white" aria-labelledby="models-heading">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-2">
      <div>
        <h2 id="models-heading" class="text-3xl font-black">Hybrids we work on</h2>
        <p class="mt-3 text-white/80">
          Toyota and Lexus hybrids are our bread and butter, but we take on other makes too. If yours is not
          listed, ask — the answer is usually yes.
        </p>
        <ul class="mt-5 flex flex-col gap-3">
          {
            models.map((model) => (
              <li class="flex items-start gap-3">
                <BatteryCharging className="mt-1 h-5 w-5 shrink-0 text-brand-green" aria-hidden="true" />
                <span class="text-white/90">{model}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col justify-center gap-4 rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
        <ShieldCheck className="h-10 w-10 text-brand-green" aria-hidden="true" />
        <h3 class="text-2xl font-bold">Genuine parts and warranty</h3>
        <p class="text-white/80">
          Whatever we fit is a genuine part, and our work is covered by a warranty. We will show you what we
          found and explain the options before anything is replaced.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-3xl px-4 py-12">
      <h2 id="faq-heading" class="text-3xl font-black text-navy">Hybrid battery questions we get asked a lot</h2>
      <dl class="mt-6 flex flex-col gap-6">
        {
          faqs.map((faq) => (
            <div data-reveal>
              <dt class="text-lg font-bold text-navy">{faq.question}</dt>
              <dd class="mt-1 text-slate-600">{faq.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 py-12 text-center">
    <h2 class="text-3xl font-black text-navy">Get your hybrid battery checked</h2>
    <p class="max-w-lg text-slate-600">
      Open 7 days a week with same-day bookings, on Tavistock Street in Bletchley. Tell us what the car is
      doing and we will take it from there.
    </p>
    <WhatsAppButton variant="large" />
    <p class="text-slate-600">
      Or see <a class="font-semibold text-brand-blue underline underline-offset-4" href={url('/services')}
        >everything else we do</a
      >.
    </p>
  </section>
</BaseLayout>
