---
import { MapPin, Phone } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton, { WhatsAppIcon } from '../components/WhatsAppButton.jsx';
import OpeningHours from '../components/OpeningHours.jsx';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import MapEmbed from '../components/MapEmbed.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import WazeIcon from '../components/icons/WazeIcon.astro';
import GoogleMapsIcon from '../components/icons/GoogleMapsIcon.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { site, address, phones, map, serviceAreas, hoursSummary, enquiryHref } from '../config/site';

const directionsHref = map.directionsUrl;
---

<BaseLayout
  title="Contact & Directions | Toyotech Hybrid Autos, Bletchley"
  description="Contact Toyotech Hybrid Autos, Tavistock Street, Bletchley, Milton Keynes. WhatsApp or call for same-day bookings. MOTs 7 days a week, workshop Monday to Saturday."
>
  <BreadcrumbSchema slot="head" items={[{ name: 'Contact', path: '/contact' }]} />

  <section class="bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h1 class="text-4xl font-black">Contact Toyotech in Bletchley</h1>
      <p class="mt-3 max-w-2xl text-lg text-white/80">
        The quickest way to book is WhatsApp — send your reg and what you need.
      </p>
      <p class="mt-2 text-white/80">{hoursSummary.workshop} · {hoursSummary.mot}</p>
      <div class="mt-6">
        <WhatsAppButton variant="large" />
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-2">
    <div class="space-y-10">
      <div>
        <h2 class="text-2xl font-bold text-navy">Call or WhatsApp us</h2>
        <ul class="mt-4 space-y-3">
          {
            phones.map((p) => (
              <li class="flex items-center gap-3 rounded-xl bg-white p-4 ring-1 ring-slate-200">
                <a href={`tel:${p.tel}`} class="min-w-0 flex-1 hover:underline">
                  <span class="block text-xl font-bold text-navy tabular-nums">{p.display}</span>
                  <span class="block text-sm text-slate-500">
                    {p.label}
                    {p.whatsapp ? ' · call or WhatsApp' : ''}
                  </span>
                </a>
                <a
                  href={`tel:${p.tel}`}
                  class="btn-motion flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-red text-white hover:bg-brand-red-dark"
                  aria-label={`Call ${p.display}`}
                >
                  <Phone className="h-5 w-5" />
                </a>
                {p.whatsapp && (
                  <a
                    href={enquiryHref(p.whatsapp)}
                    data-whatsapp-enquiry={p.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-motion flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-whatsapp text-navy hover:bg-whatsapp-hover"
                    aria-label={`WhatsApp ${p.display} (opens WhatsApp)`}
                  >
                    <WhatsAppIcon className="h-6 w-6" />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-navy">Visit us</h2>
        <address class="mt-4 flex gap-3 not-italic text-lg">
          <MapPin className="mt-1 h-5 w-5 shrink-0 text-brand-red" />
          <span>
            {site.name}<br />
            {address.line1}<br />
            {address.line2}, {address.city}<br />
            {address.postcode}
          </span>
        </address>
        <div class="mt-4 flex flex-wrap gap-3">
          <a
            href={directionsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-motion inline-flex items-center gap-2 rounded-full border-2 border-slate-200 bg-white px-5 py-3 font-bold text-navy hover:border-slate-300 hover:shadow-md"
          >
            <GoogleMapsIcon class="h-5 w-5" /> Get directions<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a
            href={map.wazeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-motion inline-flex items-center gap-2 rounded-full bg-waze px-5 py-3 font-bold text-navy hover:bg-waze-hover hover:shadow-md"
          >
            <WazeIcon class="h-4 w-4" /> Waze<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-navy">Areas we cover</h2>
        <p class="mt-3 text-slate-700">
          Our workshop is on Tavistock Street in Bletchley. Customers come to us from {serviceAreas.slice(0, -1).join(', ')}{' '}
          and across {serviceAreas.at(-1)} for MOTs, servicing and hybrid repairs.
        </p>
      </div>
    </div>

    <div class="space-y-10">
      <div id="map" class="scroll-mt-24"><MapEmbed /></div>

      <div class="rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200">
        <OpeningHours client:load />
      </div>
    </div>
  </section>

  <GoogleReviews />

  <section>
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="mb-6 text-2xl font-bold text-navy">Our workshop</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <figure>
          <div class="overflow-hidden rounded-2xl">
            <ImagePlaceholder
              name="workshop"
              alt="The Toyotech MOT Centre unit at 80-86 Tavistock Street, Bletchley: an open roller-door bay under a blue sign, with a blue MOT testing station sign above the fence beside it"
              aspect="aspect-[4/3]"
              class="object-[center_35%]"
              sizes="(min-width: 1152px) 552px, (min-width: 640px) 50vw, 100vw"
              label="Workshop photo coming soon"
            />
          </div>
          <figcaption class="mt-2 text-sm text-slate-600">
            Look for the blue Toyotech signs and the MOT triangle at Unit 6.
          </figcaption>
        </figure>
        <div class="overflow-hidden rounded-2xl">
          <ImagePlaceholder name="team" alt="The Toyotech team" aspect="aspect-[4/3]" label="Team photo coming soon" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
