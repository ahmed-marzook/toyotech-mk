---
import { CalendarDays, BatteryCharging, Zap, ArrowRight, MapPin, Phone } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.jsx';
import OpeningHours from '../components/OpeningHours.jsx';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import MapEmbed from '../components/MapEmbed.astro';
import WazeIcon from '../components/icons/WazeIcon.astro';
import GoogleMapsIcon from '../components/icons/GoogleMapsIcon.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import { services } from '../content/services';
import { site, address, phones, map, url } from '../config/site';

const highlights = [
  { icon: CalendarDays, title: 'Open 7 days a week', text: 'Weekday and weekend slots to fit around you.' },
  { icon: BatteryCharging, title: 'Hybrid specialists', text: 'Hybrid know-how, plus MOTs and servicing for all cars.' },
  { icon: Zap, title: 'Same-day bookings', text: 'Message us in the morning, sorted the same day.' },
];
---

<BaseLayout
  title="Toyotech MOT Centre | Hybrid Specialists in Milton Keynes"
  description="Toyotech MOT Centre in Bletchley, Milton Keynes — hybrid vehicle specialists offering MOTs, servicing, brakes, repairs and diagnostics. Open 7 days, same-day bookings."
>
  <LocalBusinessSchema slot="head" />

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy text-white">
    <div class="absolute inset-0 -z-10 opacity-30">
      <ImagePlaceholder name="hero" alt="" aspect="" dark label="Hero photo coming soon" />
    </div>
    <div class="absolute inset-0 -z-10 bg-linear-to-b from-navy/60 via-navy/80 to-navy"></div>

    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <h1 class="text-5xl font-black uppercase leading-[0.95] sm:text-7xl">
        <span
          class="inline-block -skew-x-6 bg-linear-to-r from-brand-green to-green-500 px-3 py-1 text-3xl text-navy sm:text-5xl"
          ><span class="inline-block skew-x-6">MOT Centre</span></span
        ><br />
        <span class="mt-2 inline-block">Is <span class="text-brand-green">Open</span></span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/85">
        Hybrid specialists in Bletchley, Milton Keynes — expert care for all makes and models. Open 7 days a week
        with same-day bookings.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <WhatsAppButton variant="large" label="Book on WhatsApp" />
        <a
          href={`tel:${phones[0].tel}`}
          class="btn-motion inline-flex min-h-14 items-center justify-center rounded-full border-2 border-white/40 px-6 py-4 text-lg font-bold hover:bg-white/10 active:bg-white/15"
        >
          Call {phones[0].display}
        </a>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="border-y-2 border-brand-green bg-navy-light text-white" aria-labelledby="highlights-heading">
    <h2 id="highlights-heading" class="sr-only">Why choose Toyotech</h2>
    <ul class="mx-auto grid max-w-6xl gap-px sm:grid-cols-3">
      {
        highlights.map(({ icon: Icon, title, text }) => (
          <li class="flex items-start gap-4 px-4 py-6">
            <Icon className="h-9 w-9 shrink-0 text-brand-green" />
            <div>
              <h3 class="text-lg font-bold">{title}</h3>
              <p class="text-sm text-white/80">{text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Services preview + hours -->
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <h2 class="text-3xl font-black text-navy">What we do</h2>
      <p class="mt-2 text-slate-600">From MOTs to hybrid battery checks — one local garage for all of it.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          // Mobile/tablet: the 6 featured services. Desktop (lg): all of them, which
          // fills the column beside the opening-hours card.
          services.map((s) => {
            const Icon = s.icon;
            return (
              <li class:list={[!s.featured && 'hidden lg:block']}>
                <a
                  href={url(`/services#${s.slug}`)}
                  class="card-motion flex h-full items-center gap-3 rounded-xl bg-white p-4 ring-1 ring-slate-200 hover:ring-brand-blue"
                >
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-blue/10 text-brand-blue">
                    <Icon className="h-6 w-6" />
                  </span>
                  <span>
                    <span class="block font-bold text-navy">{s.name}</span>
                    <span class="block text-sm text-slate-500">{s.summary}</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <a href={url('/services')} class="mt-6 inline-flex items-center gap-2 font-bold text-brand-blue hover:underline">
        <span class="lg:hidden">All {services.length} services</span>
        <span class="hidden lg:inline">Full service details</span>
        <ArrowRight className="h-4 w-4" />
      </a>
    </div>

    <div class="rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200 lg:col-span-2">
      <OpeningHours client:load />
      <p class="mt-4 text-sm text-slate-600">{address.full}</p>
    </div>
  </section>

  <GoogleReviews />

  <!-- Location -->
  <section class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-14 lg:grid-cols-5" aria-labelledby="find-us-heading">
    <div class="lg:col-span-2">
      <h2 id="find-us-heading" class="text-3xl font-black text-navy">Find us</h2>
      <address class="mt-4 flex gap-3 text-lg not-italic">
        <MapPin className="mt-1 h-5 w-5 shrink-0 text-brand-red" />
        <span>
          {site.name}<br />
          {address.line1}<br />
          {address.line2}, {address.city}<br />
          {address.postcode}
        </span>
      </address>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={map.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-motion inline-flex items-center justify-center gap-2 rounded-full bg-gmaps px-5 py-3 font-bold text-white hover:bg-gmaps-hover hover:shadow-md"
        >
          <GoogleMapsIcon class="h-4 w-4" /> Get directions<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a
          href={map.wazeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-motion inline-flex items-center justify-center gap-2 rounded-full bg-waze px-5 py-3 font-bold text-navy hover:bg-waze-hover hover:shadow-md"
        >
          <WazeIcon class="h-4 w-4" /> Waze<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a
          href={`tel:${phones[0].tel}`}
          class="btn-motion inline-flex items-center justify-center gap-2 rounded-full border-2 border-brand-blue px-5 py-3 font-bold text-brand-blue hover:bg-brand-blue hover:text-white hover:shadow-md"
        >
          <Phone className="h-4 w-4" /> Call {phones[0].display}
        </a>
      </div>
    </div>
    <MapEmbed class="lg:col-span-3" />
  </section>

  <!-- CTA band -->
  <section class="bg-navy text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 py-12 text-center">
      <h2 class="text-3xl font-black">Need an MOT today?</h2>
      <p class="max-w-lg text-white/80">Send us your reg and what you need — we’ll reply with a time and a price.</p>
      <WhatsAppButton variant="large" />
    </div>
  </section>
</BaseLayout>
