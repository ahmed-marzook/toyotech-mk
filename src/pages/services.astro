---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.jsx';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { BatteryCharging, ShieldCheck, Check } from 'lucide-react';
import { services } from '../content/services';
import { servicePackages } from '../content/service-packages';

// Tier colours: strong colour for the card's top edge (decorative), pale
// tint behind navy text for the badge (well above 4.5:1).
const tierStyle = {
  Bronze: { edge: '#b87333', tint: '#f3d9c2' },
  Silver: { edge: '#9aa5b1', tint: '#e3e8ee' },
  Gold: { edge: '#d4a017', tint: '#f8e7a8' },
};

const callouts = [
  {
    icon: ShieldCheck,
    title: 'Genuine Parts and Warranty',
    text: 'We fit genuine parts and back our work with a warranty, whatever the make or model.',
  },
  {
    icon: BatteryCharging,
    title: 'Hybrid Specialists',
    text: 'Hybrid battery testing and repair, and hybrid system servicing, from a team that knows hybrids inside out.',
  },
];
---

<BaseLayout
  title="MOT, Servicing & Hybrid Repairs in Bletchley | Toyotech Hybrid Autos"
  description="MOTs, servicing, brakes, diagnostics, clutch, suspension, AC and hybrid battery repairs for all makes at Toyotech Hybrid Autos, Bletchley, Milton Keynes. Genuine parts and warranty."
>
  <BreadcrumbSchema slot="head" items={[{ name: 'Services', path: '/services' }]} />

  <section class="bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h1 class="text-4xl font-black">Our services in Bletchley, Milton Keynes</h1>
      <p class="mt-3 max-w-2xl text-lg text-white/80">
        Hybrid specialists — expert care for all makes and models, using genuine parts.
      </p>
    </div>
  </section>

  <section class="border-b-2 border-brand-green bg-navy-light text-white" aria-labelledby="why-heading">
    <h2 id="why-heading" class="sr-only">Why choose Toyotech</h2>
    <ul class="mx-auto grid max-w-6xl gap-px md:grid-cols-2">
      {
        callouts.map(({ icon: Icon, title, text }) => (
          <li class="flex items-start gap-4 px-4 py-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-green/15">
              <Icon className="h-7 w-7 text-brand-green" />
            </span>
            <div>
              <h3 class="text-xl font-bold">{title}</h3>
              <p class="text-white/80">{text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="packages-heading">
    <h2 id="packages-heading" class="text-3xl font-black text-navy">Car servicing packages in Bletchley</h2>
    <p class="mt-2 max-w-2xl text-slate-600">
      Three levels of service for all makes and models, including hybrids. Pick a package and send us your reg on
      WhatsApp, and we'll confirm what your car needs and book you in.
    </p>
    <ul class="mt-8 grid gap-6 lg:grid-cols-3">
      {
        servicePackages.map((pkg) => (
          <li
            class="flex flex-col rounded-2xl border-t-8 bg-white p-6 shadow-sm ring-1 ring-slate-200"
            style={`border-top-color: ${tierStyle[pkg.tier].edge}`}
          >
            <span
              class="self-start rounded-full px-3 py-1 text-xs font-bold tracking-widest text-navy uppercase"
              style={`background-color: ${tierStyle[pkg.tier].tint}`}
            >
              {pkg.tier}
            </span>
            <h3 class="mt-3 text-2xl font-black text-navy">{pkg.name}</h3>
            <p class="mt-2 text-slate-600">{pkg.summary}</p>
            {pkg.builds && <p class="mt-4 font-bold text-navy">Everything in {pkg.builds}, plus:</p>}
            <ul class:list={['space-y-2 text-slate-700', pkg.builds ? 'mt-2' : 'mt-4']}>
              {pkg.includes.map((item) => (
                <li class="flex gap-2">
                  <Check className="mt-0.5 h-5 w-5 shrink-0 text-brand-blue" />
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-6">
              <WhatsAppButton variant="large" enquiry={pkg.enquiry} label={`Book ${pkg.tier} service`} />
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-slate-500">
      What's included can vary with make, model and mileage. We'll always tell you before doing any extra work.
    </p>
  </section>

  <section class="bg-slate-50" aria-labelledby="all-services-heading">
    <div class="mx-auto max-w-6xl px-4 pt-12">
      <h2 id="all-services-heading" class="text-3xl font-black text-navy">Repairs and other services</h2>
    </div>
    <div class="mx-auto grid max-w-6xl gap-6 px-4 pt-8 pb-12 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 py-12 text-center">
    <h2 class="text-3xl font-black text-navy">Not sure what you need?</h2>
    <p class="max-w-lg text-slate-600">Describe the problem on WhatsApp and we’ll point you in the right direction.</p>
    <WhatsAppButton variant="large" />
  </section>
</BaseLayout>
