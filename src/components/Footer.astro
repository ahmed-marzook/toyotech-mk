---
import { MapPin, Phone, Clock } from 'lucide-react';
import Logo from './Logo.astro';
import { site, address, phones, nav, url } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="bg-navy pb-24 text-white/80 md:pb-0">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo />
      <p class="mt-3 text-sm">{site.tagline}</p>
    </div>

    <div>
      <h2 class="mb-3 font-bold text-white">Address</h2>
      <p class="flex gap-2 text-sm">
        <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-brand-red" />
        <span>
          {address.line1}<br />
          {address.line2}, {address.city}<br />
          {address.postcode}
        </span>
      </p>
    </div>

    <div>
      <h2 class="mb-3 font-bold text-white">Call us</h2>
      <ul class="space-y-1 text-sm">
        {
          phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`} class="inline-flex min-h-11 items-center gap-2 hover:text-white">
                <Phone className="h-4 w-4 text-brand-red" />
                {p.display}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="mb-3 font-bold text-white">Opening</h2>
      <p class="flex gap-2 text-sm">
        <Clock className="mt-0.5 h-4 w-4 shrink-0 text-brand-red" />
        <span>Open 7 days a week<br />Same-day bookings available</span>
      </p>
      <nav aria-label="Footer">
        <ul class="mt-4 flex gap-4 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={url(item.path)} class="inline-flex min-h-11 items-center hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-white/60">
    &copy; {year} {site.name} · {site.altName}
  </div>
</footer>
