---
import type { Service } from '../content/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
const Icon = service.icon;
---

<!-- Scroll reveal on the wrapper, hover lift on the card, so the two transforms don't fight -->
<div data-reveal id={service.slug} class="min-w-0 scroll-mt-24">
  <article class="card-motion flex h-full flex-col rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-200">
    <div class="mb-3 flex items-center gap-3">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-blue/10 text-brand-blue">
        <Icon className="h-6 w-6" />
      </span>
      <h3 class="text-xl font-bold text-navy">{service.name}</h3>
    </div>
    <p class="text-slate-600">{service.description}</p>
  </article>
</div>
