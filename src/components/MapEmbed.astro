---
/**
 * MapEmbed.astro — a self-hosted static screenshot of the workshop location.
 *
 * Replaces the earlier MapLibre GL + OpenFreeMap live map. That setup was
 * genuinely cookie-free, but tile rendering proved unreliable in practice —
 * confirmed blank on the live site in both Chrome and Brave, with no clean
 * root cause pinned down. A static image sidesteps both problems (cookies,
 * and now reliability) at the cost of never updating itself if the
 * workshop's surroundings change — acceptable here since the actual
 * "get me there" job is fully covered by the Google Maps / Waze buttons
 * below, which are plain outbound links, not embeds.
 *
 * The screenshot is sourced from OpenStreetMap, not Google Maps — an
 * earlier draft used a Google Maps capture, but Google's Maps Platform
 * terms generally restrict caching/redistributing their map imagery outside
 * their own approved display methods (the live iframe or JS API), which a
 * self-hosted screenshot isn't. OSM's data licence (ODbL, cartography under
 * CC BY-SA) explicitly permits this, with attribution (below the image).
 * The pin is custom-drawn (same shape as the lucide MapPin icon used
 * elsewhere on the site, in brand red) over the exact coordinates OSM's own
 * marker pointed to, replacing OSM's default marker.
 *
 * It's a native <details> so visitors can collapse it, even without JS.
 * The Google Maps / Waze buttons are plain <a> links, so the map is never
 * the only way to find the workshop.
 */
import { Image } from 'astro:assets';
import { MapPin, ChevronDown } from 'lucide-react';
import WazeIcon from './icons/WazeIcon.astro';
import GoogleMapsIcon from './icons/GoogleMapsIcon.astro';
import { address, map } from '../config/site';
import workshopMap from '../assets/workshop-map.png';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<details class:list={['details-motion group overflow-hidden rounded-2xl ring-1 ring-slate-200', className]} open>
  <summary
    class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 bg-slate-50 px-4 py-3 hover:bg-slate-100 motion-safe:transition-colors motion-safe:duration-(--duration-fast) motion-safe:ease-(--ease-motion) [&::-webkit-details-marker]:hidden"
  >
    <span class="flex items-center gap-2 font-bold text-navy">
      <MapPin className="h-5 w-5 text-brand-red" />
      Map of the workshop
    </span>
    <ChevronDown className="h-4 w-4 text-slate-500 group-open:rotate-180 motion-safe:transition-transform motion-safe:duration-(--duration-fast) motion-safe:ease-(--ease-motion)" />
  </summary>

  <div class="relative aspect-[4/3] w-full bg-slate-100 sm:aspect-video">
    <Image
      src={workshopMap}
      alt={`Map showing Toyotech MOT Centre at ${address.full}`}
      class="h-full w-full object-cover"
      widths={[400, 800, 1127]}
      sizes="(min-width: 1024px) 600px, 100vw"
    />
    <a
      href="https://www.openstreetmap.org/copyright"
      target="_blank"
      rel="noopener noreferrer"
      class="absolute right-2 bottom-2 rounded bg-white/80 px-1.5 py-0.5 text-[0.6rem] text-slate-600 underline hover:bg-white"
    >
      © OpenStreetMap contributors
    </a>
  </div>

  <div class="flex flex-wrap gap-3 bg-slate-50 px-4 py-3">
    <a
      href={map.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-motion inline-flex items-center gap-2 rounded-full bg-gmaps px-4 py-2 text-sm font-bold text-white hover:bg-gmaps-hover hover:shadow-md"
    >
      <GoogleMapsIcon class="h-4 w-4" /> Google Maps<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a
      href={map.wazeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-motion inline-flex items-center gap-2 rounded-full bg-waze px-4 py-2 text-sm font-bold text-navy hover:bg-waze-hover hover:shadow-md"
    >
      <WazeIcon class="h-4 w-4" /> Waze<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</details>
