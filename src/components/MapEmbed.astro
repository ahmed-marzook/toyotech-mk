---
/**
 * MapEmbed.astro — OpenFreeMap vector map for /contact/ and /.
 *
 * Cookie-free replacement for the old Google Maps iframe: OpenFreeMap serves
 * public-domain OSM vector tiles with no API key, no account and no tracking
 * (https://openfreemap.org), rendered client-side with MapLibre GL. Nothing
 * here sets a cookie on the visitor's browser.
 *
 * It's a native <details> so visitors can collapse it, even without JS. The
 * Google Maps / Waze buttons below it are plain <a> links (not part of the
 * map render), so the map is never the only way to find the workshop — the
 * noscript message and the try/catch fallback in the script below mean a JS
 * failure still leaves those buttons standing on their own.
 *
 * Accessibility: the map gets a descriptive aria-label (WCAG 4.1.2) once it
 * loads, MapLibre's default keyboard nav (arrow keys pan, +/- zoom) works
 * once the map is focused, and cooperativeGestures stops it trapping
 * page-scroll on trackpad/touch.
 */
import { MapPin, ChevronDown, Navigation, Navigation2 } from 'lucide-react';
import { address, map } from '../config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const mapLabel = `Map showing Toyotech MOT Centre at ${address.full}`;
---

<details class:list={['details-motion group overflow-hidden rounded-2xl ring-1 ring-slate-200', className]} open>
  <summary
    class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 bg-slate-50 px-4 py-3 hover:bg-slate-100 motion-safe:transition-colors motion-safe:duration-(--duration-fast) motion-safe:ease-(--ease-motion) [&::-webkit-details-marker]:hidden"
  >
    <span class="flex items-center gap-2 font-bold text-navy">
      <MapPin className="h-5 w-5 text-brand-red" />
      Map of the workshop
    </span>
    <span class="flex items-center gap-2 text-sm text-slate-500">
      OpenStreetMap · no cookies
      <ChevronDown className="h-4 w-4 group-open:rotate-180 motion-safe:transition-transform motion-safe:duration-(--duration-fast) motion-safe:ease-(--ease-motion)" />
    </span>
  </summary>

  <div class="aspect-[4/3] w-full bg-slate-100 sm:aspect-video">
    <div
      class="workshop-map h-full w-full"
      data-lat={map.lat}
      data-lng={map.lng}
      data-zoom={map.zoom}
      data-style={map.styleUrl}
      data-label={mapLabel}
    >
      <noscript>
        <p class="flex h-full items-center justify-center p-4 text-center text-sm text-slate-600">
          Enable JavaScript to see the map, or use the buttons below to get directions.
        </p>
      </noscript>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 bg-slate-50 px-4 py-3">
    <a
      href={map.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-motion inline-flex items-center gap-2 rounded-full bg-brand-blue px-4 py-2 text-sm font-bold text-white hover:bg-navy hover:shadow-md"
    >
      <Navigation className="h-4 w-4" /> Google Maps<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a
      href={map.wazeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-motion inline-flex items-center gap-2 rounded-full border-2 border-brand-blue px-4 py-2 text-sm font-bold text-brand-blue hover:bg-brand-blue hover:text-white hover:shadow-md"
    >
      <Navigation2 className="h-4 w-4" /> Waze<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</details>

<script>
  import { Map as MapLibreMap, Marker, NavigationControl } from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  function initMap(container) {
    const lat = Number(container.dataset.lat);
    const lng = Number(container.dataset.lng);
    const zoom = Number(container.dataset.zoom);
    const style = container.dataset.style;
    const label = container.dataset.label;
    if (!style || Number.isNaN(lat) || Number.isNaN(lng)) return;

    try {
      const map = new MapLibreMap({
        container,
        style,
        center: [lng, lat],
        zoom,
        attributionControl: { compact: true },
        cooperativeGestures: true,
      });
      map.addControl(new NavigationControl({ showCompass: false }), 'top-right');
      new Marker({ color: '#d5222a' }).setLngLat([lng, lat]).addTo(map);
      map.getCanvas().setAttribute('aria-label', label ?? 'Map');

      const details = container.closest('details');
      details?.addEventListener('toggle', () => {
        if (details.open) map.resize();
      });
    } catch {
      container.innerHTML =
        '<p class="flex h-full items-center justify-center p-4 text-center text-sm text-slate-600">Interactive map unavailable — use the buttons below to get directions.</p>';
    }
  }

  document.querySelectorAll('.workshop-map').forEach(initMap);
</script>
