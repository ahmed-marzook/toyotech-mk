---
/**
 * JSON-LD FAQPage — only ever pass the same Q&A pairs rendered visibly on the
 * page (Google's structured data guidelines require the two to match).
 */
interface QA {
  question: string;
  answer: string;
}

interface Props {
  items: QA[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((qa) => ({
    '@type': 'Question',
    name: qa.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: qa.answer,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
