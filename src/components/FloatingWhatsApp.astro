---
/**
 * Floating WhatsApp button (mobile only), with a dismiss button so it never
 * permanently covers content. Dismissal lasts for the browser session.
 * It sits at the end of <body>, so it's the last thing in the tab order and
 * can't trap focus.
 */
import { X } from 'lucide-react';
import WhatsAppButton from './WhatsAppButton.jsx';
---

<div id="floating-whatsapp" class="fixed right-4 bottom-4 z-50 flex items-start md:hidden">
  <button
    type="button"
    id="floating-whatsapp-dismiss"
    class="-mr-3 -mt-3 flex h-11 w-11 items-center justify-center rounded-full"
    aria-label="Hide the floating WhatsApp button"
  >
    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-navy text-white shadow ring-2 ring-white">
      <X className="h-3.5 w-3.5" strokeWidth={3} />
    </span>
  </button>
  <WhatsAppButton variant="floating" label="Message us on WhatsApp" />
</div>

<script>
  const KEY = 'toyotech:floating-whatsapp-dismissed';
  const root = document.getElementById('floating-whatsapp');
  const hide = () => root?.remove();
  try {
    if (sessionStorage.getItem(KEY)) hide();
  } catch {}
  document.getElementById('floating-whatsapp-dismiss')?.addEventListener('click', () => {
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {}
    // Move focus somewhere sensible before the button disappears
    document.getElementById('main')?.focus();
    hide();
  });
</script>
