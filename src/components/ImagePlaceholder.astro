---
/**
 * Renders a real photo from src/assets/ when one exists with the given name
 * (e.g. name="service-mot" → src/assets/service-mot.jpg|jpeg|png|webp|avif),
 * otherwise a clearly marked placeholder. Drop photos in — no code changes.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ImageIcon } from 'lucide-react';

interface Props {
  name: string;
  /**
   * Describes the real photo once it exists. Pass "" for purely decorative
   * images (e.g. the hero background). The grey placeholder itself carries no
   * information, so it is always hidden from screen readers.
   */
  alt: string;
  class?: string;
  /** Tailwind aspect-ratio class, e.g. "aspect-video" */
  aspect?: string;
  label?: string;
  dark?: boolean;
}

const {
  name,
  alt,
  class: className = '',
  aspect = 'aspect-video',
  label = 'Image coming soon',
  dark = false,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpg,jpeg,png,webp,avif}');
const match = Object.keys(images).find((path) => path.split('/').pop()?.replace(/\.\w+$/, '') === name);
const src = match ? (await images[match]()).default : undefined;
---

{
  src ? (
    <Image src={src} alt={alt} class:list={['h-full w-full object-cover', aspect, className]} />
  ) : (
    <div
      aria-hidden="true"
      data-image-name={name}
      class:list={[
        'flex h-full w-full flex-col items-center justify-center gap-2 border-2 border-dashed',
        dark ? 'border-white/20 bg-white/5 text-white/40' : 'border-slate-300 bg-slate-100 text-slate-600',
        aspect,
        className,
      ]}
    >
      <ImageIcon className="h-10 w-10" />
      <span class="text-xs font-semibold uppercase tracking-wider">{label}</span>
    </div>
  )
}
